<Window x:Class="PsyReaSFX.Desktop.ProjectUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PsyReaSFX · Project usage" Width="1080" Height="620" MinWidth="760" MinHeight="430"
        WindowStartupLocation="CenterOwner" Icon="Assets/psyreasfx-icon.png"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="6" Padding="14,11" Margin="0,0,0,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="Heading" Text="REAPER 工程使用记录" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="Subheading" Text="由可选 Bridge 成功送入工程的素材" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Image Grid.Column="1" Source="Assets/psyreasfx-icon.png" Width="38" Height="38" Stretch="Uniform"/>
      </Grid>
    </Border>
    <DataGrid x:Name="UsageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <DataGrid.Columns>
        <DataGridTextColumn x:Name="TimeColumn" Header="时间" Binding="{Binding CreatedText}" Width="150"/>
        <DataGridTextColumn x:Name="AssetColumn" Header="素材" Binding="{Binding AssetName}" Width="260"/>
        <DataGridTextColumn x:Name="ProjectColumn" Header="REAPER 工程" Binding="{Binding ProjectName}" Width="200"/>
        <DataGridTextColumn x:Name="ActionColumn" Header="方式" Binding="{Binding ActionText}" Width="135"/>
        <DataGridTextColumn x:Name="TrackColumn" Header="轨道" Binding="{Binding TrackText}" Width="160"/>
        <DataGridTextColumn x:Name="PositionColumn" Header="位置" Binding="{Binding PositionText}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="RevealButton" Content="打开素材位置" Padding="18,6" Click="Reveal_Click"/>
        <Button x:Name="CloseButton" Content="关闭" Padding="24,6" Margin="8,0,0,0" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
