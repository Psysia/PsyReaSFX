<Window x:Class="PsyReaSFX.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PsyReaSFX 设置" Width="880" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Icon="Assets/psyreasfx-icon.png">
  <Window.Resources>
    <Style x:Key="SettingsNav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="Card" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelHoverBrush}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource HeaderBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Margin" Value="0,7" />
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource MutedBrush}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource HeaderBrush}" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource BgBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="4,2,4,14">
            <Image Source="Assets/psyreasfx-icon.png" Width="34" Height="34" />
            <StackPanel Margin="9,0,0,0"><TextBlock Text="PsyReaSFX" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Desktop settings" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
          </StackPanel>
          <RadioButton x:Name="GeneralNav" GroupName="Page" Style="{StaticResource SettingsNav}" IsChecked="True" Checked="Page_Checked">常规</RadioButton>
          <RadioButton x:Name="AppearanceNav" GroupName="Page" Style="{StaticResource SettingsNav}" Checked="Page_Checked">外观</RadioButton>
          <RadioButton x:Name="WaveformNav" GroupName="Page" Style="{StaticResource SettingsNav}" Checked="Page_Checked">波形与性能</RadioButton>
          <RadioButton x:Name="TransferNav" GroupName="Page" Style="{StaticResource SettingsNav}" Checked="Page_Checked">传输</RadioButton>
          <RadioButton x:Name="MaintenanceNav" GroupName="Page" Style="{StaticResource SettingsNav}" Checked="Page_Checked">维护</RadioButton>
          <RadioButton x:Name="AboutNav" GroupName="Page" Style="{StaticResource SettingsNav}" Checked="Page_Checked">关于</RadioButton>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22,12,18,22">
          <StackPanel x:Name="GeneralPage">
            <TextBlock Text="常规" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="只显示当前桌面版已经实际接通的选项。" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,15"/>
            <TextBlock Text="界面语言" Style="{StaticResource SectionLabel}" Margin="0,4,0,7"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ChineseLanguage" GroupName="Language" Style="{StaticResource Choice}" Checked="Language_Checked">简体中文</RadioButton>
              <RadioButton x:Name="EnglishLanguage" GroupName="Language" Style="{StaticResource Choice}" Checked="Language_Checked">English</RadioButton>
            </StackPanel>
            <TextBlock Text="保存后主界面立即切换；重新启动时保持所选语言。" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,8"/>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,12"/>
            <TextBlock Text="试听" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"/>
            <CheckBox x:Name="AutoPreviewCheck" Content="选择素材后自动试听" />
            <TextBlock Text="列表连续移动时会短暂等待，避免为经过的每一行反复打开文件。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="空格键行为" Style="{StaticResource SectionLabel}" Margin="0,18,0,7"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="SpacePauseResume" GroupName="SpaceBehavior" Style="{StaticResource Choice}">暂停 / 继续</RadioButton>
              <RadioButton x:Name="SpaceRestartSelection" GroupName="SpaceBehavior" Style="{StaticResource Choice}">从选区起点重新播放</RadioButton>
            </StackPanel>
            <TextBlock Text="播放按钮始终使用标准暂停 / 继续逻辑；此选项只影响 Space。" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16"/>
            <TextBlock Text="启动布局" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
            <CheckBox x:Name="NavigationCheck" Content="启动时显示左侧导航" />
            <CheckBox x:Name="InspectorCheck" Content="启动时显示右侧元数据" />
          </StackPanel>
          <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
            <TextBlock Text="外观" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="主题与颜色" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,15"/>
            <TextBlock Text="主题与颜色" Style="{StaticResource SectionLabel}" Margin="0,4,0,7"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="DarkTheme" GroupName="ThemePreset" Style="{StaticResource Choice}" Checked="ThemePreset_Checked">黑暗模式</RadioButton>
              <RadioButton x:Name="ClassicTheme" GroupName="ThemePreset" Style="{StaticResource Choice}" Checked="ThemePreset_Checked">传统模式</RadioButton>
            </StackPanel>
            <TextBlock Text="点击色块打开系统色盘；修改会立即预览，保存后持久保留。" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,12" TextWrapping="Wrap"/>
            <UniformGrid Columns="2">
              <Button x:Name="FrameColorButton" Tag="FrameColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="PanelColorButton" Tag="PanelColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
              <Button x:Name="HeaderColorButton" Tag="HeaderColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="LineColorButton" Tag="LineColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
              <Button x:Name="TextColorButton" Tag="TextColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="MutedTextColorButton" Tag="MutedTextColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
              <Button x:Name="AccentColorButton" Tag="AccentColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
              <Button x:Name="SelectedRowColorButton" Tag="SelectedRowColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="PlayedTextColorButton" Tag="PlayedTextColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="WaveformColorButton" Tag="WaveformColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
              <Button x:Name="SelectedWaveformColorButton" Tag="SelectedWaveformColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="PlayedWaveformColorButton" Tag="PlayedWaveformColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
              <Button x:Name="MarkedWaveformColorButton" Tag="MarkedWaveformColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="SelectionColorButton" Tag="SelectionColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
              <Button x:Name="PlayheadColorButton" Tag="PlayheadColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,8,3"/>
              <Button x:Name="RegionColorButton" Tag="RegionColor" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" Margin="0,3,0,3"/>
            </UniformGrid>
            <CheckBox x:Name="PlayedWaveformHighlightCheck" Content="已播放素材使用独立波形颜色" Margin="0,10,0,2"/>
            <Button Content="恢复当前主题默认颜色" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetThemeColors_Click"/>
          </StackPanel>
          <StackPanel x:Name="WaveformPage" Visibility="Collapsed">
            <TextBlock Text="波形与性能" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="精度越高，首次读取所需的磁盘与处理时间越多。" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,15"/>
            <TextBlock Text="列表波形精度" Style="{StaticResource SectionLabel}" Margin="0,4,0,7"/>
            <StackPanel Orientation="Horizontal"><RadioButton x:Name="Inline256" GroupName="InlineResolution" Style="{StaticResource Choice}">256 点（更快）</RadioButton><RadioButton x:Name="Inline512" GroupName="InlineResolution" Style="{StaticResource Choice}">512 点（更细）</RadioButton></StackPanel>
            <TextBlock Text="大波形精度" Style="{StaticResource SectionLabel}" Margin="0,20,0,7"/>
            <StackPanel Orientation="Horizontal"><RadioButton x:Name="Detail2048" GroupName="DetailResolution" Style="{StaticResource Choice}">2048 点</RadioButton><RadioButton x:Name="Detail4096" GroupName="DetailResolution" Style="{StaticResource Choice}">4096 点</RadioButton></StackPanel>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>
            <TextBlock Text="响度统计" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/>
            <CheckBox x:Name="ShowLoudnessCheck" Content="显示当前素材响度统计" />
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="ShowLufsICheck" Content="LUFS-I" Margin="0,7,18,7"/><CheckBox x:Name="ShowLufsMCheck" Content="LUFS-M max" Margin="0,7,18,7"/>
              <CheckBox x:Name="ShowLufsSCheck" Content="LUFS-S max" Margin="0,7,18,7"/><CheckBox x:Name="ShowTruePeakCheck" Content="True Peak" Margin="0,7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <CheckBox x:Name="LoudnessMatchCheck" Content="试听时匹配响度" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <TextBlock Text="目标 LUFS-I" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
              <TextBox x:Name="LoudnessMatchTargetText" Width="82"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16"/>
            <TextBlock Text="瞬态 Region 建议" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,3,12,3"><TextBlock Text="阈值 (dBFS)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="TransientThresholdText"/></StackPanel>
              <StackPanel Margin="0,3,0,3"><TextBlock Text="平滑时间 (ms)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="TransientSmoothingText"/></StackPanel>
              <StackPanel Margin="0,3,12,3"><TextBlock Text="最小间隔 (ms)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="TransientIntervalText"/></StackPanel>
              <StackPanel Margin="0,3,0,3"><TextBlock Text="最大 Region 数" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="TransientMaxText"/></StackPanel>
              <StackPanel Margin="0,3,12,3"><TextBlock Text="Region 前置 (ms)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="TransientPreRollText"/></StackPanel>
              <StackPanel Margin="0,3,0,3"><TextBlock Text="Region 后置 (ms)" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="TransientPostRollText"/></StackPanel>
            </UniformGrid>
            <CheckBox x:Name="ReplaceTransientCheck" Content="检测时替换已有瞬态建议" />
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>
            <TextBlock Text="性能说明" FontWeight="SemiBold"/>
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="PsyReaSFX 只为屏幕上可见的结果读取列表波形。正在试听时会优先保证音频与播放指针，不让后台波形任务抢占交互。"/>
          </StackPanel>
          <StackPanel x:Name="TransferPage" Visibility="Collapsed">
            <TextBlock Text="传输" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="处理、命名与导出" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,15"/>
            <TextBlock Text="输出目录" Style="{StaticResource SectionLabel}" Margin="0,4,0,3"/>
            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8">
              <TextBlock x:Name="TransferOutputPathText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </Border>
            <Button Content="打开目录" HorizontalAlignment="Left" Margin="0,9,0,0" Click="OpenTransferOutput_Click"/>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18"/>
            <TextBlock Text="完整的 Transfer 参数位于独立面板，可从主界面或 Ctrl+T 打开。设置会自动保存。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="MaintenancePage" Visibility="Collapsed">
            <TextBlock Text="维护" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="目录监视、任务恢复、备份与缓存健康检查。" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,15"/>
            <TextBlock Text="Watch Folder" Style="{StaticResource SectionLabel}" Margin="0,4,0,3"/>
            <CheckBox x:Name="WatchFoldersCheck" Content="自动监视已启用的音效库路径"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="变更合并等待（秒）" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="WatchDebounceText" Width="74"/>
            </StackPanel>
            <CheckBox x:Name="ResumeScanCheck" Content="启动时恢复上次中断的增量扫描"/>
            <TextBlock x:Name="CheckpointStatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="重试失败任务" Click="RetryFailed_Click"/>
              <Button Content="清除恢复记录" Click="ClearRecovery_Click"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18"/>
            <TextBlock Text="数据库备份与恢复" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/>
            <CheckBox x:Name="AutomaticBackupCheck" Content="每天自动创建一份数据库备份"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="保留份数" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="BackupRetentionText" Width="74"/>
            </StackPanel>
            <TextBlock x:Name="BackupStatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="立即备份" Click="CreateBackup_Click"/>
              <Button Content="打开备份目录" Click="OpenBackups_Click"/>
              <Button Content="下次启动恢复最新备份" Click="RestoreLatest_Click"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18"/>
            <TextBlock Text="波形缓存目录" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/>
            <TextBlock Text="列表与高精度波形缓存存放在此目录。更改目录时可以迁移已有缓存，不会移动源音频。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,8,0,0">
              <TextBlock x:Name="CacheDirectoryText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="更改缓存目录…" Click="ChangeCacheDirectory_Click"/>
              <Button Content="打开缓存目录" Click="OpenCacheDirectory_Click"/>
              <Button Content="恢复默认目录" Click="RestoreCacheDirectory_Click"/>
            </StackPanel>
            <TextBlock x:Name="CacheMoveStatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18"/>
            <TextBlock Text="缓存完整性" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/>
            <TextBlock Text="验证现有 RWF 波形缓存；损坏文件会被安全移除并在需要时自动重建。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <Button Content="检查并修复波形缓存" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CheckCache_Click"/>
            <TextBlock x:Name="CacheStatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18"/>
            <TextBlock Text="桌面数据库" Style="{StaticResource SectionLabel}" Margin="0,4,0,3"/><TextBlock x:Name="DataPathText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <Button Content="打开数据目录" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenData_Click"/>
            <TextBlock Text="诊断日志" Style="{StaticResource SectionLabel}" Margin="0,20,0,3"/><TextBlock x:Name="LogPathText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <Button Content="打开日志目录" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenLogs_Click"/>
          </StackPanel>
          <StackPanel x:Name="AboutPage" Visibility="Collapsed" HorizontalAlignment="Center" MaxWidth="520">
            <Image Source="Assets/psyreasfx-icon.png" Width="92" Height="92" Margin="0,18,0,12"/>
            <TextBlock TextAlignment="Center" FontFamily="./Assets/Fonts/#Orbitron" FontSize="26" FontWeight="SemiBold"><Run Text="PsyRea"/><Run Text="SFX" Foreground="{DynamicResource AccentBrightBrush}"/></TextBlock>
            <TextBlock Text="Sound assets organized" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,20"/>
            <TextBlock Text="Desktop 0.7.23 · Alpha 7 Light Hotfix 2" TextAlignment="Center"/>
            <TextBlock Text="Copyright © 2026 Psysia. All rights reserved." TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
        <Button Content="取消" Width="100" Click="Cancel_Click"/><Button Content="保存并关闭" Width="126" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource AccentBrush}" Click="Save_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
