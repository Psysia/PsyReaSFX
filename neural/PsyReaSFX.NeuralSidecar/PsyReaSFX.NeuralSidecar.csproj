<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PsyReaSFX.NeuralSidecar</AssemblyName>
    <RootNamespace>PsyReaSFX.NeuralSidecar</RootNamespace>
    <Version>0.4.0</Version>
    <Authors>Psysia</Authors>
    <Product>PsyReaSFX Neural Similarity Sidecar</Product>
    <Description>Optional local neural audio embedding helper for PsyReaSFX.</Description>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
</Project>
